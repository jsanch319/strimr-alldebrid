{
  "name": "strimr-discord-watch-together",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test server/*.test.ts",
    "prepare:mkv": "tsx tools/prepareMkv.ts",
    "test:browser": "tsx --test browser/*.test.ts"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "hls.js": "^1.7.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.2",
    "puppeteer-core": "^25.18.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "overrides": {
    "zod": "^4.6.6"
  }
}
